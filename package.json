{
  "name": "biner-launcher",
  "version": "0.4.1",
  "description": "Official BinerCraft Minecraft Launcher",
  "main": "src/boot.js",
  "author": "BinerCraft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm run prepare-icon && electron-builder",
    "dist": "npm run prepare-icon && electron-builder --win",
    "prepare-icon": "node scripts/generate-icon.js",
    "check": "node --check src/main.js && node --check src/boot.js && node --check src/preload.js && node --check src/biner-core.js && node --check src/download-manager.js && node --check src/java-manager.js && node --check src/loader-manager.js && node --check src/v040.js && node --check src/auto-updater.js && node --check src/renderer/app.js"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "ir.binercraft.launcher",
    "productName": "Biner Launcher",
    "directories": { "output": "dist", "buildResources": "." },
    "files": ["src/**/*", "package.json", "icon.png", "icon.ico"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "artifactName": "Biner-Launcher-Setup-${version}.${ext}", "icon": "icon.ico" },
    "nsis": { "oneClick": true, "perMachine": false, "allowElevation": true, "allowToChangeInstallationDirectory": false, "createDesktopShortcut": "always", "createStartMenuShortcut": true, "shortcutName": "Biner Launcher", "runAfterFinish": true, "installerIcon": "icon.ico", "installerHeaderIcon": "icon.ico", "uninstallerIcon": "icon.ico", "language": "1033", "unicode": true, "deleteAppDataOnUninstall": false }
  }
}
