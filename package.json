{
  "name": "biner-launcher",
  "version": "0.3.0",
  "description": "Official BinerCraft Minecraft Launcher",
  "main": "src/main.js",
  "author": "BinerCraft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "minecraft-launcher-core": "^3.18.2",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ir.binercraft.launcher",
    "productName": "Biner Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Biner-Launcher-Setup-${version}.${ext}",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Biner Launcher",
      "runAfterFinish": true,
      "installerIcon": "icon.png",
      "installerHeaderIcon": "icon.png",
      "language": "1033",
      "unicode": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
